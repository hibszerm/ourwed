# Supabase (required)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Document AI — production uses Edge Function `document-ai-analysis` + OPENAI_API_KEY
# (Supabase Secrets only; never put OpenAI keys in Vite).
# Optional: force mock analyzer for offline UI work
# VITE_DOCUMENT_AI_USE_MOCK=true
# Dev-only: dual-pass extraction diagnostic (Pass 1 business understanding + Pass 2 production)
# Runs two AI calls per analysis. Never enabled in production builds.
# VITE_DOCUMENT_AI_DIAGNOSTIC=true

# Product wedding contracts use sparse Full-AI changedBlocks (Mode A download policy).
# Does not use Comparison Lab Mode B guarded completeness blocking.
# Emergency rollback to legacy slot-based generation (analyzed templates only):
# VITE_USE_SPARSE_WEDDING_CONTRACT_GENERATION=false

# AI Contract Lab (experimental, isolated) — comparison / debugging only.
# Requires Edge Function `ai-contract-lab-analyze` + server secrets:
#   OPENAI_API_KEY
#   OPENAI_CONTRACT_MODEL=gpt-5-mini   (lab-only; does NOT use OPENAI_MODEL)
# VITE_ENABLE_AI_CONTRACT_LAB=true
# Optional: show Full AI vs Guarded AI side-by-side in Transform Lab
# VITE_ENABLE_CONTRACT_AI_DEBUG_MODES=true
# Optional default test wedding (still RLS-enforced):
# VITE_AI_CONTRACT_LAB_WEDDING_ID=

# Experimental DOCX → PDF (self-hosted Gotenberg / LibreOffice).
# Client flags only — never put GOTENBERG_* in Vite:
# VITE_ENABLE_EXPERIMENTAL_PDF_EXPORT=true
# Local PDF without supabase start (dev only; ignored in production builds):
# VITE_LOCAL_PDF_FUNCTION_URL=http://127.0.0.1:54322/docx-to-pdf
# Server / npm run dev:pdf (or Edge Function secrets):
#   ENABLE_EXPERIMENTAL_PDF_EXPORT=true
#   GOTENBERG_URL=http://localhost:3000
#   GOTENBERG_API_KEY=                 (optional)
# Local terminals:
#   docker compose --profile gotenberg up gotenberg
#   npm run dev:pdf
#   npm run dev
# Production Gotenberg hosting may incur infrastructure cost; use HTTPS + network restrictions.

# Address autocomplete / travel use Google via Edge Functions.
# Server secret (Places + Routes) — Supabase Edge only, never Vite:
#   GOOGLE_MAPS_API_KEY
# Browser key (Maps JavaScript API only) — HTTP referrer restricted:
VITE_GOOGLE_MAPS_BROWSER_KEY=
# Optional cloud Map ID (enables AdvancedMarkerElement styling):
# VITE_GOOGLE_MAPS_MAP_ID=

# Google Calendar + Apple Calendar (Phase 1) — Edge secrets only, never Vite:
#   GOOGLE_CALENDAR_CLIENT_ID
#   GOOGLE_CALENDAR_CLIENT_SECRET
#   GOOGLE_CALENDAR_REDIRECT_URI=https://<PROJECT_REF>.supabase.co/functions/v1/google-calendar-oauth/callback
#   APP_PUBLIC_URL=http://localhost:5173
#   CALENDAR_TOKEN_ENCRYPTION_KEY=   (optional AES key; defaults derived from client secret)
# Setup: docs/calendar-integrations-setup.md
# Deploy:
#   supabase functions deploy google-calendar-oauth
#   supabase functions deploy google-calendar-sync
#   supabase functions deploy apple-calendar-feed

# Landing page version (default v1). Also: ?landing=v2 or localStorage ourwed:landing-version
# VITE_LANDING_VERSION=v2
