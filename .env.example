# Supabase (required)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Document AI — production uses Edge Function `document-ai-analysis` + OPENAI_API_KEY
# (Supabase Secrets only; never put OpenAI keys in Vite).
# Optional: force mock analyzer for offline UI work
# VITE_DOCUMENT_AI_USE_MOCK=true
# Dev-only: dual-pass extraction diagnostic (Pass 1 business understanding + Pass 2 production)
# Runs two AI calls per analysis. Never enabled in production builds.
# VITE_DOCUMENT_AI_DIAGNOSTIC=true

# Product wedding contracts use sparse Full-AI changedBlocks (Mode A download policy).
# Does not use Comparison Lab Mode B guarded completeness blocking.
# Emergency rollback to legacy slot-based generation (analyzed templates only):
# VITE_USE_SPARSE_WEDDING_CONTRACT_GENERATION=false

# AI Contract Lab (experimental, isolated) — comparison / debugging only.
# Requires Edge Function `ai-contract-lab-analyze` + server secrets:
#   OPENAI_API_KEY
#   OPENAI_CONTRACT_MODEL=gpt-5-mini   (lab-only; does NOT use OPENAI_MODEL)
# VITE_ENABLE_AI_CONTRACT_LAB=true
# Optional: show Full AI vs Guarded AI side-by-side in Transform Lab
# VITE_ENABLE_CONTRACT_AI_DEBUG_MODES=true
# Optional default test wedding (still RLS-enforced):
# VITE_AI_CONTRACT_LAB_WEDDING_ID=

# Experimental DOCX → PDF (Gotenberg / LibreOffice) — DEVELOPMENT / LAB ONLY.
# Not used by production Wedding Brief PDF (PDFShift) or production contract PDF (Cloudmersive).
# Client flags only — never put GOTENBERG_* in Vite:
# VITE_ENABLE_EXPERIMENTAL_PDF_EXPORT=true
# Local PDF without supabase start (dev only; ignored in production builds):
# VITE_LOCAL_PDF_FUNCTION_URL=http://127.0.0.1:54322/docx-to-pdf
# Server / npm run dev:pdf (or Edge Function secrets for lab DOCX→PDF):
#   ENABLE_EXPERIMENTAL_PDF_EXPORT=true
#   GOTENBERG_URL=http://localhost:3000
#   GOTENBERG_API_KEY=                 (optional)
# Local terminals:
#   docker compose --profile gotenberg up gotenberg
#   npm run dev:pdf
#   npm run dev
# Docs: docs/local-pdf-dev.md
#
# -----------------------------------------------------------------------------
# PDFShift HTML→PDF — PRODUCTION brief renderer (Edge Function `pdf-render`)
# Server / Edge secrets only — never VITE_:
#   PDFSHIFT_API_KEY=sk_...
#   PDF_RENDER_TIMEOUT_MS=60000          (optional; default 60s)
#   PDF_RENDER_ALLOW_SANDBOX=true        (optional staging/POC only; unset in prod)
# Script comparison tooling (npm run pdf:pdfshift-poc):
#   PDF_RENDER_PROVIDER=local|pdfshift
#   PDFSHIFT_POC_LIVE=1
#   PDFSHIFT_POC_SANDBOX=false
# Deploy:
#   supabase secrets set PDFSHIFT_API_KEY=sk_...
#   supabase functions deploy pdf-render
# Docs: docs/pdf-rendering.md
# Contract PDF via HTML→PDFShift is STOPPED (incomplete vs final DOCX).
# -----------------------------------------------------------------------------
# Cloudmersive DOCX→PDF — PRODUCTION contract PDF (Edge Function `contract-docx-to-pdf`)
# Server / Edge secrets only — never VITE_CLOUDMERSIVE_API_KEY:
#   CLOUDMERSIVE_API_KEY=...
#   CLOUDMERSIVE_TIMEOUT_MS=60000          (optional)
# Deploy:
#   supabase secrets set CLOUDMERSIVE_API_KEY=...
#   supabase functions deploy contract-docx-to-pdf
# Free tier max file size: 3.5 MB (3,670,016 bytes) — Edge refuses the API call if exceeded.
# Privacy: Cloudmersive receives the full final contract DOCX (names, addresses,
# phone/email if present, wedding date, prices, legal wording). Do not send tokens/keys.
# Comparison POC (optional; not required for production):
#   CONTRACT_PDF_POC_DOCX=/path/to/final-generated-contract.docx
#   CLOUDMERSIVE_POC_LIVE=1
#   npm run pdf:cloudmersive-docx-poc
# Docs: docs/pdf-rendering.md
# -----------------------------------------------------------------------------
# Lab Gotenberg hosting may incur infrastructure cost; use HTTPS + network restrictions.
# Production contract PDF does NOT require GOTENBERG_URL / localhost / Docker.

# Address autocomplete / travel use Google via Edge Functions.
# Server secret (Places + Routes) — Supabase Edge only, never Vite:
#   GOOGLE_MAPS_API_KEY
# Browser key (Maps JavaScript API only) — HTTP referrer restricted:
VITE_GOOGLE_MAPS_BROWSER_KEY=
# Optional cloud Map ID (enables AdvancedMarkerElement styling):
# VITE_GOOGLE_MAPS_MAP_ID=

# Google Calendar + Apple Calendar (Phase 1) — Edge secrets only, never Vite:
#   GOOGLE_CALENDAR_CLIENT_ID
#   GOOGLE_CALENDAR_CLIENT_SECRET
#   GOOGLE_CALENDAR_REDIRECT_URI=https://<PROJECT_REF>.supabase.co/functions/v1/google-calendar-oauth/callback
#   APP_PUBLIC_URL=http://localhost:5173
#   CALENDAR_TOKEN_ENCRYPTION_KEY=   (optional AES key; defaults derived from client secret)
# Setup: docs/calendar-integrations-setup.md
# Deploy:
#   supabase functions deploy google-calendar-oauth
#   supabase functions deploy google-calendar-sync
#   supabase functions deploy apple-calendar-feed

# -----------------------------------------------------------------------------
# Notification Engine V1 — Edge secrets only (never VITE_ / never browser):
#   RESEND_API_KEY=               # Resend send API (dispatcher)
#   RESEND_FROM_EMAIL=OurWed <powiadomienia@ourwed.pl>   # must be verified domain
#   APP_PUBLIC_URL=https://ourwed.pl   # CTA base (production)
#   NOTIFICATION_DISPATCH_SECRET= # shared secret for pg_net / DB webhook → dispatcher
#   RESEND_WEBHOOK_SECRET=        # existing Svix secret for resend-webhook
# DB settings (optional async dispatch via pg_net):
#   ALTER DATABASE postgres SET app.settings.notification_dispatcher_url =
#     'https://<PROJECT_REF>.supabase.co/functions/v1/notification-email-dispatcher';
#   ALTER DATABASE postgres SET app.settings.notification_dispatch_secret =
#     '<same as NOTIFICATION_DISPATCH_SECRET>';
# Docs: docs/notification-engine.md
# Deploy:
#   supabase db push
#   supabase functions deploy notification-email-dispatcher
#   supabase functions deploy resend-webhook
# -----------------------------------------------------------------------------

# Landing page version (default v1). Also: ?landing=v2 or localStorage ourwed:landing-version
# VITE_LANDING_VERSION=v2

# -----------------------------------------------------------------------------
# OurWed Admin Phase 1 (admin.ourwed.pl / localhost:5173/admin)
# Server-only — never put these in Vite / never prefix with VITE_:
#   SUPABASE_URL=https://YOUR_PROJECT.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#   ADMIN_PUBLIC_URL=http://localhost:5173/admin
# Create owner once: npm run admin:create-owner
# Docs: docs/admin-phase1.md
# -----------------------------------------------------------------------------
